# Echo/vLLM deployment
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_BIND_ADDRESS=0.0.0.0
VLLM_PORT=8096
VLLM_LOCAL_PORT=8097
GPU_DEVICE=1
MODEL_ID=google/gemma-4-12b-it
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=32768
MAX_IMAGES_PER_PROMPT=4

# Client-side benchmark target. Keep this in a laptop-only .env, not Echo.
INFERENCE_BASE_URL=http://echo:8096/v1
INFERENCE_API_KEY=EMPTY
